    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all"/>
    </ItemGroup>
    <ItemGroup>
        <Reference Include="MMHOOK">
            <HintPath>/home/jordan/.config/r2modmanPlus-local/Valheim/profiles/ValheimDev/BepInEx/plugins/MMHOOK/Managed/MMHOOK_assembly_valheim.dll</HintPath>
        </Reference>
    </ItemGroup>
</Project>
